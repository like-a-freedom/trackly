{
  "name": "frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ./wasm/fast_paths_wasm --target web --out-dir ./public/wasm --out-name fast_paths_wasm",
    "build": "vite build",
    "preview": "vite preview",
    "preview:seo": "vite preview --port 4173",
    "check:seo": "node scripts/check-seo.cjs",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "test": "vitest run --dir src",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kangc/v-md-editor": "^1.7.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueform/multiselect": "^2.6.11",
    "@vueform/slider": "^2.1.10",
    "@vueuse/core": "^14.2.1",
    "@vueuse/head": "^2.0.0",
    "agent-browser": "^0.21.2",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.17.23",
    "lucide-vue-next": "^0.563.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.30",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.4",
    "vue-sonner": "^2.0.9",
    "vue3-slider": "^1.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^8.57.1",
    "vue-eslint-parser": "^9.4.3",
    "@typescript-eslint/parser": "^8.57.1",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "form-data": "^4.0.5",
    "jsdom": "^28.1.0",
    "playwright": "^1.58.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.1",
    "vitest": "^4.1.0",
    "vitest-canvas-mock": "^1.1.3"
