{
  "name": "frontend",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build ./wasm/fast_paths_wasm --target web --out-dir ./public/wasm --out-name fast_paths_wasm",
    "prebuild": "vue-tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "preview:seo": "vite preview --port 4173",
    "check:seo": "node scripts/check-seo.cjs",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "typecheck": "vue-tsc --noEmit",
    "typecheck:watch": "vue-tsc --noEmit --watch",
    "test": "vitest run --dir src",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kangc/v-md-editor": "^1.7.12",
    "@types/leaflet.markercluster": "^1.5.6",
    "@vue-leaflet/vue-leaflet": "^0.10.1",
    "@vueform/multiselect": "^2.6.11",
    "@vueform/slider": "^2.1.10",
    "@vueuse/core": "^14.4.0",
    "@vueuse/head": "^2.0.0",
    "agent-browser": "^0.36.0",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "leaflet": "^1.9.4",
    "leaflet-polylinedecorator": "^1.6.0",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "lodash-es": "^4.18.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1",
    "vue-sonner": "^2.0.9",
    "vue3-slider": "^1.10.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "form-data": "^4.0.6",
    "jsdom": "^30.1.2",
    "playwright": "^1.63.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vitest-canvas-mock": "^1.2.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.12"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
